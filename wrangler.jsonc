{
  "name": "killer-game-api",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-11-20",
  "vars": {
    "ALLOWED_ORIGIN": "https://justrebl.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "killer-game",
      "database_id": "TODO"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "killer-game-photos"
    }
  ]
}
